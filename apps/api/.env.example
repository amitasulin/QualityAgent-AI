# QualityAgent Backend Environment Variables
# Copy this file to .env and modify values as needed

# App
APP_NAME=QualityAgent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database (postgres:// and postgresql:// URLs are normalized automatically,
# including sslmode=require from managed providers)
DATABASE_URL=postgresql+asyncpg://qualityagent:qualityagent_dev@localhost:5432/qualityagent

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma separated list or a JSON array)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage (S3-compatible - MinIO for local dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=qualityagent
S3_REGION=us-east-1

# AI (OpenAI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Demo Tenant (for development)
DEMO_TENANT_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
ALLOW_DEMO_LOGIN=true